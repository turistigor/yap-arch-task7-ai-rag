{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "create_kdb",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["create"]
        },
        {
            "name": "replace_kdb",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["replace"]
        },
        {
            "name": "kdb_all",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["all"]
        },
        {
            "name": "run bot",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_bot",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/rag-bot",
            "justMyCode": false,
            "args": ["run_bot"],
            "env": {
                "OLLAMA_LOAD_IN_GPU": "1"
            }
        },
        {
            "name": "test embs",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_bot",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/rag-bot",
            "justMyCode": false,
            "args": [
                "test_embeddings",
                "intfloat/multilingual-e5-small",
                "chroma",
                "qwen2.5:3b"
            ],
            "env": {
                "OLLAMA_LOAD_IN_GPU": "1"
            }
        },
        {
            "name": "test rag bot",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_bot",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/rag-bot",
            "justMyCode": false,
            "args": [
                "test_rag_bot", 
                "intfloat/multilingual-e5-small",
                "chroma",
                "qwen2.5:3b"
            ],
            "env": {
                "OLLAMA_LOAD_IN_GPU": "1"
            }
        }
    ]
}
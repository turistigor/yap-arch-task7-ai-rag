    "version": "0.2.0",
    "configurations": [
        {
            "name": "create_kdb",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["create"]
        },
        {
            "name": "replace_kdb",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["replace"]
        },
        {
            "name": "kdb_all",
            "type": "debugpy",
            "request": "launch",
            "module": "knowledge_base",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/knowledge-base",
            "justMyCode": false,
            "args": ["all"]
        },
        {
            "name": "create_vdb",
            "type": "debugpy",
            "request": "launch",
            "module": "rag_bot",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/rag-bot",
